{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "web" }
    }
  ]
}
