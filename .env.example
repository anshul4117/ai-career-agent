# ==============================================================================
# AI Career Agent — Monorepo Production & Local Environment Variables
# Single Vercel Project Architecture: Next.js (apps/web) + NestJS (apps/api)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL) — SECRET (Backend only)
# ------------------------------------------------------------------------------
# Neon connection string. In production on Vercel, use the pooled connection string
# (pgbouncer) for runtime and direct connection for migrations.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECRETS — SECRET (Backend only, never expose to client)
# ------------------------------------------------------------------------------
# 32+ character high-entropy secret keys for HMAC-SHA256 signing
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"

# Token expiration times (optional, defaults: 15m and 7d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND DOMAINS (Backend)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. In production on Vercel, same-origin
# calls and *.vercel.app preview URLs are automatically supported.
CORS_ORIGIN="http://localhost:3000,https://ai-career-agent-web.vercel.app"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
# Base canonical URL for SEO (metadataBase, sitemap.xml, robots.txt)
# In production on Vercel, automatically detected from VERCEL_PROJECT_PRODUCTION_URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL for local development (optional, defaults to http://localhost:4000/api/v1)
# NOTE: In production browser sessions, requests use same-origin relative path /api/v1
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Internal backend URL for Next.js server-side rewrites / SSR (optional)
INTERNAL_API_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 5. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
