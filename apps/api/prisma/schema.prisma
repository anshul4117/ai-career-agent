// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  LINKEDIN
}

enum ResumeFileType {
  PDF
  DOCX
}

enum ResumeStatus {
  ACTIVE
  ARCHIVED
}

enum ParsingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  DEVOPS
  TOOL
  AI_ML
  OTHER
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EducationType {
  HIGH_SCHOOL
  INTERMEDIATE
  DIPLOMA
  ITI
  CERTIFICATE
  BACHELORS
  MASTERS
  PHD
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1001_5000
  SIZE_5000_PLUS
}

enum SalaryPeriod {
  YEARLY
  MONTHLY
  HOURLY
  UNKNOWN
}

enum JobSourcePlatform {
  COMPANY
  WELLFOUND
  YC
  INTERNSHALA
  NAUKRI
  LINKEDIN
  DIRECT
  OTHER
}

enum ApplicationStatusSource {
  EMAIL
  LINKEDIN
  WELLFOUND
  COMPANY
  MANUAL
  SYSTEM
}

// ============================================================================
// CORE USER & AUTHENTICATION MODELS
// ============================================================================

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  fullName         String
  profilePhotoUrl  String?
  subscriptionPlan SubscriptionPlan @default(FREE)
  emailVerified    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  resumes              Resume[]
  jobApplications      JobApplication[]
  reviewedParseResults ResumeParseResult[] @relation("ReviewedParseResults")

  profile          Profile?
  socialLinks      SocialLink[]
  certifications   Certification[]
  languages        Language[]
  careerPreference CareerPreference?
  userSkills       UserSkill[]
  education        Education[]
  experience       Experience[]
  projects         Project[]

  @@map("users")
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique // SHA-256 hash of high-entropy random token
  familyId            String    // UUID identifying rotation lineage (for replay attack detection)
  isRevoked           Boolean   @default(false)
  replacedByTokenHash String?   // Pointer to successor token hash upon rotation
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// RESUME ARCHITECTURE (FOUR-TIER)
// ============================================================================

model Resume {
  id               String         @id @default(uuid())
  userId           String
  title            String
  fileUrl          String
  fileType         ResumeFileType
  fileSize         Int?
  originalFileName String?
  isDefault        Boolean        @default(false)
  status           ResumeStatus   @default(ACTIVE)
  currentVersion   Int            @default(1)

  // Builder template & styling customization
  templateId       String?        @default("default")
  themeConfig      Json?
  customSections   Json?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         ResumeVersion[]
  parseResults     ResumeParseResult[]
  analyses         ResumeAnalysis[]
  jobApplications  JobApplication[]

  @@index([userId])
  @@index([status])
  @@map("resumes")
}

model ResumeVersion {
  id              String         @id @default(uuid())
  resumeId        String
  versionNumber   Int
  title           String
  fileUrl         String?
  contentSnapshot Json           // Immutable structured snapshot (ExtractedData) of this version
  themeSnapshot   Json?          // Styling snapshot at time of version creation
  changeSummary   String?
  createdAt       DateTime       @default(now())

  resume          Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  parseResults    ResumeParseResult[]
  analyses        ResumeAnalysis[]
  jobApplications JobApplication[]

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
  @@map("resume_versions")
}

model ResumeParseResult {
  id                   String        @id @default(uuid())
  resumeId             String
  resumeVersionId      String?
  status               ParsingStatus @default(PENDING)
  retryCount           Int           @default(0)
  maxRetries           Int           @default(3)
  errorMessage         String?
  errorCode            String?       // "FILE_CORRUPTED", "OCR_FAILED", "TIMEOUT", "RATE_LIMIT"

  // Raw & Structured Parsing Data (Immutable parser artifact)
  rawText              String?       @db.Text
  extractedData        Json?         // Structured parser output (ExtractedData)
  confidenceScores     Json?         // SectionConfidence breakdown (0-100 per section)

  // Model & Pipeline Provenance
  parserEngine         String?       // "GEMINI_VISION", "PDF_PLUMBER", "HYBRID"
  parserModel          String?       // "gemini-2.5-flash"
  modelVersion         String?
  promptVersion        String?
  processingDurationMs Int?

  // Review & Approval Audit
  isUserReviewed       Boolean       @default(false)
  reviewedAt           DateTime?
  reviewedByUserId     String?
  reviewActions        Json?         // Audit of accept/edit/ignore per section

  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  resume               Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersion        ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  reviewedBy           User?          @relation("ReviewedParseResults", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([resumeId])
  @@index([resumeVersionId])
  @@index([status])
  @@index([reviewedByUserId])
  @@map("resume_parse_results")
}

model ResumeAnalysis {
  id                    String        @id @default(uuid())
  resumeId              String
  resumeVersionId       String?
  targetJobId           String?
  targetJobTitle        String?

  overallAtsScore       Float         // 0.0 - 100.0
  qualityScore          Float?
  completenessScore     Float?
  keywordScore          Float?
  readabilityScore      Float?

  sectionScores         Json?
  matchingKeywords      String[]      @default([])
  missingKeywords       String[]      @default([])
  keywordDensity        Json?
  suggestions           Json?
  bulletImprovements    Json?
  summaryOptimization   Json?

  analyzerModel         String?
  analyzerVersion       String?
  promptVersion         String?

  createdAt             DateTime      @default(now())

  resume                Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersion         ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  targetJob             Job?          @relation(fields: [targetJobId], references: [id], onDelete: SetNull)

  @@index([resumeId])
  @@index([resumeVersionId])
  @@index([targetJobId])
  @@map("resume_analyses")
}

// ============================================================================
// PROFILE & BACKGROUND MODELS
// ============================================================================

model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique
  headline          String?
  summary           String?
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  nationality       String?
  city              String?
  state             String?
  country           String?
  currentRole       String?
  yearsOfExperience Int?      @default(0)
  preferredRole     String?
  preferredLocation String?
  workPreference    String?   @default("remote")
  availability      String?   @default("actively_looking")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model SocialLink {
  id        String   @id @default(uuid())
  userId    String
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("social_links")
}

model Certification {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  issuingOrganization String
  issueDate           DateTime
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?
  neverExpires        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

model Language {
  id             String   @id @default(uuid())
  userId         String
  language       String
  readingLevel   String
  writingLevel   String
  speakingLevel  String
  nativeLanguage Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("languages")
}

model CareerPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  preferredRole           String?
  employmentType          String?
  preferredLocation       String?
  workMode                String?
  expectedSalary          String?
  currency                String?  @default("INR")
  noticePeriod            String?
  openToWork              Boolean  @default(true)
  visaSponsorshipRequired Boolean  @default(false)
  relocationWillingness   Boolean  @default(true)
  preferredIndustry       String?
  preferredCompanySize    String?
  preferredShift          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_preferences")
}

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  skillSlug String        @unique
  category  SkillCategory
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id                String            @id @default(uuid())
  userId            String
  skillId           String
  proficiencyLevel  ProficiencyLevel
  yearsOfExperience Int?
  featured          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Education {
  id                String         @id @default(uuid())
  userId            String
  institutionName   String
  educationType     EducationType? @default(OTHER)
  qualificationName String
  fieldOfStudy      String?
  startDate         DateTime
  endDate           DateTime?
  grade             String?
  description       String?
  highestEducation  Boolean        @default(false)
  currentStudy      Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("education")
}

model Experience {
  id               String          @id @default(uuid())
  userId           String
  companyName      String
  jobTitle         String
  employmentType   EmploymentType? @default(FULL_TIME)
  location         String?
  workMode         WorkMode?       @default(REMOTE)
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean         @default(false)
  description      String?
  technologiesUsed String[]        @default([])
  responsibilities String[]        @default([])
  achievements     String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("experience")
}

model Project {
  id               String    @id @default(uuid())
  userId           String
  title            String
  shortDescription String?
  description      String
  projectUrl       String?
  repositoryUrl    String?
  startDate        DateTime?
  endDate          DateTime?
  isOngoing        Boolean   @default(false)
  featured         Boolean   @default(false)
  techStack        String[]  @default([])
  role             String?
  category         String?
  imageUrl         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

// ============================================================================
// JOB ENGINE & APPLICATION TRACKING
// ============================================================================

model Company {
  id            String      @id @default(uuid())
  name          String      @unique
  companySlug   String      @unique
  websiteUrl    String?
  careerPageUrl String?
  logoUrl       String?
  industry      String?
  headquarters  String?
  companySize   CompanySize?
  isHiring      Boolean     @default(true)
  lastJobSeenAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  jobs          Job[]

  @@map("companies")
}

model Job {
  id                 String          @id @default(uuid())
  companyId          String
  title              String
  jobSlug            String          @unique
  location           String?
  workMode           WorkMode?
  employmentType     EmploymentType?
  experienceMinYears Int?
  experienceMaxYears Int?
  salaryMin          Int?
  salaryMax          Int?
  currency           String?
  salaryPeriod       SalaryPeriod?
  description        String          @db.Text
  isActive           Boolean         @default(true)
  postedAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company            Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobSources         JobSource[]
  jobApplications    JobApplication[]
  resumeAnalyses     ResumeAnalysis[]

  @@index([companyId])
  @@map("jobs")
}

model JobSource {
  id             String            @id @default(uuid())
  jobId          String
  source         JobSourcePlatform
  sourceJobId    String?
  sourceJobUrl   String
  isActive       Boolean           @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobApplications JobApplication[]

  @@unique([jobId, source])
  @@index([jobId])
  @@map("job_sources")
}

model JobApplication {
  id               String                  @id @default(uuid())
  userId           String                  // Required. Re-assigned to System Archive User upon account deletion.
  jobId            String                  // Primary link directly to Job
  jobSourceId      String?
  resumeId         String?                 // Nullable: SetNull on resume deletion
  resumeVersionId  String?                 // Nullable: SetNull on version deletion
  
  resumeSnapshot   Json?                   // { title, candidateName, candidateEmail, candidatePhone, originalFileName }
  immutableFileKey String?                 // Version-locked object storage key
  
  status           ApplicationStatus       @default(APPLIED)
  appliedAt        DateTime                @default(now())
  notes            String?                 @db.Text

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  job              Job                     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  jobSource        JobSource?              @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  resume           Resume?                 @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeVersion    ResumeVersion?          @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  statusHistory    ApplicationStatusHistory[]

  @@index([userId])
  @@index([jobId])
  @@index([resumeId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id               String                  @id @default(uuid())
  jobApplicationId String
  status           ApplicationStatus
  statusSource     ApplicationStatusSource? @default(MANUAL)
  message          String?
  statusAt         DateTime                @default(now())
  createdAt        DateTime                @default(now())

  jobApplication   JobApplication          @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([statusAt])
  @@map("application_status_history")
}