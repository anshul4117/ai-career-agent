// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum OAuthProvider {
  GOOGLE
}

enum ResumeFileType {
  PDF
  DOCX
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  DEVOPS
  TOOL
  AI_ML
  OTHER
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EducationType {
  HIGH_SCHOOL
  INTERMEDIATE
  DIPLOMA
  ITI
  CERTIFICATE
  BACHELORS
  MASTERS
  PHD
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1001_5000
  SIZE_5000_PLUS
}

enum SalaryPeriod {
  YEARLY
  MONTHLY
  HOURLY
  UNKNOWN
}

enum JobSourcePlatform {
  COMPANY
  WELLFOUND
  YC
  INTERNSHALA
  NAUKRI
  LINKEDIN
}

enum ApplicationStatusSource {
  EMAIL
  LINKEDIN
  WELLFOUND
  COMPANY
  MANUAL
}











model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  fullName         String
  profilePhotoUrl  String?
  subscriptionPlan SubscriptionPlan @default(FREE)
  emailVerified    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  oauthAccounts OAuthAccount[]
  resumes       Resume[]

  userSkills UserSkill[]
  education  Education[]
  experience Experience[]
  projects   Project[]
  jobApplications JobApplication[]

  @@map("users")
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model Resume {
  id               String         @id @default(uuid())
  userId           String
  title            String
  fileUrl          String
  fileType         ResumeFileType
  fileSize         Int?
  originalFileName String?
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])
  jobApplications JobApplication[]

  @@map("resumes")
}

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  skillSlug String        @unique
  category  SkillCategory
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id                String            @id @default(uuid())
  userId            String
  skillId           String
  proficiencyLevel  ProficiencyLevel
  yearsOfExperience Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Education {
  id                String        @id @default(uuid())
  userId            String
  institutionName   String
  educationType     EducationType
  qualificationName String
  fieldOfStudy      String?
  startDate         DateTime
  endDate           DateTime?
  grade             String?
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("education")
}

model Experience {
  id             String         @id @default(uuid())
  userId         String
  companyName    String
  jobTitle       String
  employmentType EmploymentType
  location       String?
  workMode       WorkMode?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean        @default(false)
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("experience")
}

model Project {
  id            String    @id @default(uuid())
  userId        String
  title         String
  description   String
  projectUrl    String?
  repositoryUrl String?
  startDate     DateTime?
  endDate       DateTime?
  isOngoing     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("projects")
}

model Company {
  id            String      @id @default(uuid())
  name          String      @unique
  companySlug   String      @unique
  websiteUrl    String?
  careerPageUrl String?
  logoUrl       String?
  industry      String?
  headquarters  String?
  companySize   CompanySize?
  isHiring      Boolean     @default(true)
  lastJobSeenAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  jobs Job[]

  @@map("companies")
}

model Job {
  id                 String          @id @default(uuid())
  companyId          String
  title              String
  jobSlug            String          @unique
  location           String?
  workMode           WorkMode?
  employmentType     EmploymentType?
  experienceMinYears Int?
  experienceMaxYears Int?
  salaryMin          Int?
  salaryMax          Int?
  currency           String?
  salaryPeriod       SalaryPeriod?
  description        String
  isActive           Boolean         @default(true)
  postedAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  jobSources JobSource[]

  @@map("jobs")
}

model JobSource {
  id             String            @id @default(uuid())
  jobId          String
  source         JobSourcePlatform
  sourceJobId    String?
  sourceJobUrl   String
  isActive       Boolean           @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  job             Job               @relation(fields: [jobId], references: [id])
  jobApplications JobApplication[]

  @@unique([jobId, source])
  @@map("job_sources")
}

model JobApplication {
  id            String   @id @default(uuid())
  userId        String
  resumeId      String
  jobSourceId   String
  currentStatus String
  appliedAt     DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id])
  resume Resume    @relation(fields: [resumeId], references: [id])
  jobSource JobSource @relation(fields: [jobSourceId], references: [id])

  statusHistory ApplicationStatusHistory[]

  @@unique([userId, jobSourceId])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id               String                  @id @default(uuid())
  jobApplicationId String
  status           String
  statusSource     ApplicationStatusSource?
  message          String?
  statusAt         DateTime
  createdAt        DateTime                @default(now())

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id])

  @@map("application_status_history")
}