// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum OAuthProvider {
  GOOGLE
}

enum ResumeFileType {
  PDF
  DOCX
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  DEVOPS
  TOOL
  AI_ML
  OTHER
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EducationType {
  HIGH_SCHOOL
  INTERMEDIATE
  DIPLOMA
  ITI
  CERTIFICATE
  BACHELORS
  MASTERS
  PHD
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1001_5000
  SIZE_5000_PLUS
}

enum SalaryPeriod {
  YEARLY
  MONTHLY
  HOURLY
  UNKNOWN
}

enum JobSourcePlatform {
  COMPANY
  WELLFOUND
  YC
  INTERNSHALA
  NAUKRI
  LINKEDIN
}

enum ApplicationStatusSource {
  EMAIL
  LINKEDIN
  WELLFOUND
  COMPANY
  MANUAL
}











model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  fullName         String
  profilePhotoUrl  String?
  subscriptionPlan SubscriptionPlan @default(FREE)
  emailVerified    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  oauthAccounts OAuthAccount[]
  resumes       Resume[]

  profile          Profile?
  socialLinks      SocialLink[]
  certifications   Certification[]
  languages        Language[]
  careerPreference CareerPreference?

  userSkills UserSkill[]
  education  Education[]
  experience Experience[]
  projects   Project[]
  jobApplications JobApplication[]

  @@map("users")
}

model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique
  headline          String?
  summary           String?
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  nationality       String?
  city              String?
  state             String?
  country           String?
  currentRole       String?
  yearsOfExperience Int?      @default(0)
  preferredRole     String?
  preferredLocation String?
  workPreference    String?   @default("remote")
  availability      String?   @default("actively_looking")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model SocialLink {
  id        String   @id @default(uuid())
  userId    String
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model Certification {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  issuingOrganization String
  issueDate           DateTime
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?
  neverExpires        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Language {
  id             String   @id @default(uuid())
  userId         String
  language       String
  readingLevel   String
  writingLevel   String
  speakingLevel  String
  nativeLanguage Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("languages")
}

model CareerPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  preferredRole           String?
  employmentType          String?
  preferredLocation       String?
  workMode                String?
  expectedSalary          String?
  currency                String?  @default("INR")
  noticePeriod            String?
  openToWork              Boolean  @default(true)
  visaSponsorshipRequired Boolean  @default(false)
  relocationWillingness   Boolean  @default(true)
  preferredIndustry       String?
  preferredCompanySize    String?
  preferredShift          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_preferences")
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model Resume {
  id               String         @id @default(uuid())
  userId           String
  title            String
  fileUrl          String
  fileType         ResumeFileType
  fileSize         Int?
  originalFileName String?
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])
  jobApplications JobApplication[]

  @@map("resumes")
}

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  skillSlug String        @unique
  category  SkillCategory
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id                String            @id @default(uuid())
  userId            String
  skillId           String
  proficiencyLevel  ProficiencyLevel
  yearsOfExperience Int?
  featured          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Education {
  id                String         @id @default(uuid())
  userId            String
  institutionName   String
  educationType     EducationType? @default(OTHER)
  qualificationName String
  fieldOfStudy      String?
  startDate         DateTime
  endDate           DateTime?
  grade             String?
  description       String?
  highestEducation  Boolean        @default(false)
  currentStudy      Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("education")
}

model Experience {
  id               String          @id @default(uuid())
  userId           String
  companyName      String
  jobTitle         String
  employmentType   EmploymentType? @default(FULL_TIME)
  location         String?
  workMode         WorkMode?       @default(REMOTE)
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean         @default(false)
  description      String?
  technologiesUsed String[]        @default([])
  responsibilities String[]        @default([])
  achievements     String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("experience")
}

model Project {
  id               String    @id @default(uuid())
  userId           String
  title            String
  shortDescription String?
  description      String
  projectUrl       String?
  repositoryUrl    String?
  startDate        DateTime?
  endDate          DateTime?
  isOngoing        Boolean   @default(false)
  featured         Boolean   @default(false)
  techStack        String[]  @default([])
  role             String?
  category         String?
  imageUrl         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Company {
  id            String      @id @default(uuid())
  name          String      @unique
  companySlug   String      @unique
  websiteUrl    String?
  careerPageUrl String?
  logoUrl       String?
  industry      String?
  headquarters  String?
  companySize   CompanySize?
  isHiring      Boolean     @default(true)
  lastJobSeenAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  jobs Job[]

  @@map("companies")
}

model Job {
  id                 String          @id @default(uuid())
  companyId          String
  title              String
  jobSlug            String          @unique
  location           String?
  workMode           WorkMode?
  employmentType     EmploymentType?
  experienceMinYears Int?
  experienceMaxYears Int?
  salaryMin          Int?
  salaryMax          Int?
  currency           String?
  salaryPeriod       SalaryPeriod?
  description        String
  isActive           Boolean         @default(true)
  postedAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  jobSources JobSource[]

  @@map("jobs")
}

model JobSource {
  id             String            @id @default(uuid())
  jobId          String
  source         JobSourcePlatform
  sourceJobId    String?
  sourceJobUrl   String
  isActive       Boolean           @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  job             Job               @relation(fields: [jobId], references: [id])
  jobApplications JobApplication[]

  @@unique([jobId, source])
  @@map("job_sources")
}

model JobApplication {
  id            String   @id @default(uuid())
  userId        String
  resumeId      String
  jobSourceId   String
  currentStatus String
  appliedAt     DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id])
  resume Resume    @relation(fields: [resumeId], references: [id])
  jobSource JobSource @relation(fields: [jobSourceId], references: [id])

  statusHistory ApplicationStatusHistory[]

  @@unique([userId, jobSourceId])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id               String                  @id @default(uuid())
  jobApplicationId String
  status           String
  statusSource     ApplicationStatusSource?
  message          String?
  statusAt         DateTime
  createdAt        DateTime                @default(now())

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id])

  @@map("application_status_history")
}