PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/career_agent?schema=public"
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternatively: CLOUDINARY_URL="cloudinary://my_key:my_secret@my_cloud_name"

# Job Crawler Admin & Security Configuration
ADMIN_API_KEY="your-admin-secret-key"
ADMIN_EMAILS="admin@example.com"

# External Job Data Providers (Adzuna/RapidAPI disabled without payment card)
ADZUNA_APP_ID="" # Disabled: requires payment card
ADZUNA_APP_KEY="" # Disabled: requires payment card
RAPIDAPI_KEY=""  # Disabled: requires payment card

# Free Aggregator Providers (India coverage)
JOOBLE_API_KEY="" # Free key from https://jooble.org/api/about
CAREERJET_API_KEY="" # Careerjet API v4 Basic Auth key
ENABLE_SOURCE_CAREERJET="false" # Disabled by default: requires IP whitelisting in Careerjet portal; terms prohibit bulk offline DB ingestion

# Ingestion Balancing & Mock Toggles
MAX_COMPANY_JOB_SHARE="0.08" # Max 8% of active jobs per company
MIN_COMPANY_JOB_FLOOR="15"    # Floor of 15 jobs per company
ENABLE_MOCK_JOB_PROVIDERS="false" # Keep false in production
